# ==============================================================================
# Trading Lab Desktop — Environment Configuration Template (.env.example)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e preencha conforme seu ambiente.
# AVISO DE SEGURANÇA: NUNCA commite o arquivo .env preenchido com credenciais reais!
# No modo Desktop com interface gráfica, credenciais também podem ser salvas no
# cofre seguro do Windows (DPAPI). Para modos headless, CLI ou VPS, use este .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciais dos Brokers (Corretoras)
# ------------------------------------------------------------------------------
# Token de API da Deriv (obrigatório para conexões à Deriv)
# Obtenha em: Gerenciamento de Conta Deriv -> Segurança & Segurança -> Tokens de API
DERIV_API_TOKEN=seu_deriv_api_token_aqui

# E-mail da conta IQ Option (obrigatório, formato de e-mail válido)
IQOPTION_EMAIL=seu_email@dominio.com

# Senha da conta IQ Option (obrigatório)
IQOPTION_PASSWORD=sua_senha_secreta_aqui

# ------------------------------------------------------------------------------
# 2. Modo Operacional e Ambiente
# ------------------------------------------------------------------------------
# Modo de execução do trading:
# - demo: Operações em conta de demonstração/prática (padrão seguro)
# - live: Operações em conta real com dinheiro real (exige autorização explícita)
# - simulated: Simulação local com dados sintéticos sem envio para broker
TRADING_MODE=demo

# Ambiente de execução do sistema:
# - dev: Desenvolvimento local com logs mais verbosos
# - staging: Ambiente de homologação/testes
# - production: Ambiente de produção oficial
ENVIRONMENT=dev

# Nível de detalhamento dos logs:
# Opções: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Gestão de Risco e Limites Financeiros
# ------------------------------------------------------------------------------
# Perda máxima diária consolidada (Stop Loss Diário) em moeda base (ex: USD)
# Opcional. Se definido, deve ser um número decimal ou inteiro > 0.
# Exemplo: 50.0 para parar operações se o prejuízo diário atingir 50 dólares.
MAX_DAILY_LOSS=50.0

# ------------------------------------------------------------------------------
# 4. Telemetria e Backups
# ------------------------------------------------------------------------------
# Habilita coleta e persistência local de métricas operacionais e de sistema
# Padrão: true
ENABLE_TELEMETRY=true

# Habilita rotinas automáticas de backup de integridade de perfis e dados
# Padrão: true
BACKUP_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Comunicação Inter-Processos (IPC v1)
# ------------------------------------------------------------------------------
# Timeout máximo em segundos para resposta de chamadas IPC entre UI, Core e Workers
# Deve ser um número inteiro > 0. Padrão: 5
IPC_TIMEOUT_SECONDS=5

# Número máximo de tentativas de reenvio em caso de falha transitória de socket IPC
# Deve ser um número inteiro >= 0. Padrão: 3
IPC_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 6. Broker Resilience Layer (Deriv & IQ Option)
# ------------------------------------------------------------------------------
# Desligado por padrão para não alterar o comportamento atual sem validação
BROKER_RESILIENCE_ENABLED=false

DERIV_REQUESTS_PER_MINUTE=60
IQOPTION_REQUESTS_PER_MINUTE=30
BROKER_RATE_LIMIT_BURST=5
BROKER_CIRCUIT_FAILURE_THRESHOLD=5
BROKER_CIRCUIT_FAILURE_WINDOW_SECONDS=60
BROKER_CIRCUIT_RECOVERY_SECONDS=30
BROKER_MAX_READ_RETRIES=3
BROKER_RETRY_BASE_DELAY_SECONDS=1
BROKER_RETRY_MAX_DELAY_SECONDS=10

