# Environment configuration for Strategy Lab on Linux VPS (R-OPS-4)
# Permissions MUST be 0600 (chmod 0600 /etc/strategy-lab/env)
# Owned by: strategylab:strategylab

# Runtime environment identifier
STRATEGY_LAB_ENV=vps

# IQ Option credentials (used exclusively by collect/status under VPS headless mode)
IQ_EMAIL=""
IQ_PASSWORD=""

# Supabase Production PostgreSQL Database Connection
SUPABASE_DB_URL=""

# Supabase Hub API (Edge Functions)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage and Cache directories
STRATEGY_LAB_DATA_DIR="/var/lib/strategy-lab"
STRATEGY_LAB_LOG_DIR="/var/log/strategy-lab"
